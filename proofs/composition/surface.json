        "value": 86.0,
        "min": 20.0,
        "max": 95.0,
        "unit": "degC",
        "warn": 78.0,
        "alarm": 88.0
      },
      {
        "label": "node-02 scratch free",
        "value": 42.0,
        "min": 0.0,
        "max": 2000.0,
        "unit": "GB",
        "warn": 300.0,
        "alarm": 100.0,
        "invert": true
      }
    ]
  }
}